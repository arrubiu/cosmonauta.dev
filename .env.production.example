# Copy to .env on the production server. Never commit .env.
GHOST_ENV_FILE=.env
DOMAIN=www.cosmonauta.dev

# Do not change these after MySQL has been initialised.
DATABASE_ROOT_PASSWORD=replace-with-a-long-random-secret
DATABASE_USER=ghost
DATABASE_PASSWORD=replace-with-a-second-long-random-secret

# Persistent production data, relative to this repository unless made absolute.
UPLOAD_LOCATION=./data/production/ghost
MYSQL_DATA_LOCATION=./data/production/mysql

# Transactional email (required for Ghost admin notifications and password resets).
mail__transport=SMTP
mail__options__host=smtp.example.com
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=support@example.com
mail__options__auth__pass=replace-me
mail__from="'Cosmonauta' <support@example.com>"

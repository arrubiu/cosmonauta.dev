# Copy to .env.local for local development. Never commit .env.local.
# Values containing special characters may be single-quoted.
GHOST_ENV_FILE=.env.local
DOMAIN=localhost
GHOST_VERSION=6.55.0-alpine
DATABASE_ROOT_PASSWORD=local-root-password
DATABASE_USER=ghost
DATABASE_PASSWORD=local-ghost-password
UPLOAD_LOCATION=./data/local/ghost
MYSQL_DATA_LOCATION=./data/local/mysql

# Used only by ./local.sh sync. The production paths are fixed in local.sh.
PRODUCTION_SSH=deploy@example.com

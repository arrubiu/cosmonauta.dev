# Copy to .env.local for local development. Never commit .env.local.
GHOST_ENV_FILE=.env.local
DOMAIN=localhost
DATABASE_ROOT_PASSWORD=local-root-password
DATABASE_USER=ghost
DATABASE_PASSWORD=local-ghost-password
UPLOAD_LOCATION=./data/local/ghost
MYSQL_DATA_LOCATION=./data/local/mysql

# Used only by ./local.sh sync. The production checkout must contain ./ghost.sh.
PRODUCTION_SSH=deploy@example.com
PRODUCTION_PROJECT_DIR=/srv/cosmonauta.dev
